{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/post-scheduler",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/token-reminder",
      "schedule": "0 8 * * *"
    }
  ]
}