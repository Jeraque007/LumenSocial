# Supabase
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Admin Access (password to access the scheduler UI)
ADMIN_PASSWORD=your_secret_password_here

# LinkedIn (Community Management API)
# Default = the S.A.E organisation page (brand 'S.A.E Method').
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_AUTHOR_URN=urn:li:person:YOUR_PERSON_ID
LINKEDIN_REFRESH_TOKEN=your_linkedin_refresh_token
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
# Sylvana Ellis' MAIN PERSONAL LinkedIn profile. Used by the brands 'Tessera Lumen' AND 'HOAWS' -
# those two post to her personal profile, everything else posts to the organisation account above.
LINKEDIN_PERSONAL_ACCESS_TOKEN=your_linkedin_personal_access_token
LINKEDIN_PERSONAL_REFRESH_TOKEN=your_linkedin_personal_refresh_token
LINKEDIN_PERSONAL_AUTHOR_URN=urn:li:person:YOUR_PERSON_ID

# Facebook (Graph API)
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
FACEBOOK_PAGE_ID=your_facebook_page_id
# Both brands' Page tokens are (re)generated together in one visit at /api/auth/facebook-token -
# see the HOAWS block below.
# HOAWS brand Facebook Page credentials (used automatically when a scheduled post's brand is 'HOAWS').
# The Page token must be a PAGE token holding pages_manage_posts + pages_read_engagement.
# /api/auth/facebook-token?user_token=... derives them from a 60-day long-lived User token, so the
# Page tokens never expire - this is what stops the "fix HOAWS and SAE breaks" cycle.
HOAWS_FACEBOOK_PAGE_ACCESS_TOKEN=your_hoaws_facebook_page_access_token
# HOAWS Page "HOAWS" - ID 430882193436029 (verified via debug_token: type=PAGE, scopes pages_manage_posts,
# pages_read_engagement, pages_show_list, business_management).
HOAWS_FACEBOOK_PAGE_ID=430882193436029
# Optional User tokens. If a *_PAGE_ACCESS_TOKEN variable ever holds a USER token, Meta answers
# error 190 "…must be granted before impersonating a user's page". With these set, the Facebook
# connector derives the Page token from the User token and retries automatically.
FACEBOOK_USER_ACCESS_TOKEN=your_facebook_user_access_token
HOAWS_FACEBOOK_USER_ACCESS_TOKEN=your_hoaws_facebook_user_access_token
# Required by /api/auth/facebook-token and /api/auth/instagram-token (appsecret_proof + token exchange)
FACEBOOK_APP_SECRET=your_facebook_app_secret
# Optional: the LumenSocial Meta app id, used as the fb_exchange_token client_id when
# /api/auth/facebook-token exchanges a short-lived User token for a long-lived one. Falls back to the
# app id baked into the endpoint when unset.
FACEBOOK_APP_ID=1358945715605007

# Instagram (Meta Graph API)
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
# IMPORTANT: BUSINESS_ACCOUNT_ID / GRAPH_USER_ID must be the Instagram *professional account ID*:
# the user_id field of GET https://graph.instagram.com/v25.0/me (also the number listed next to the
# account in App Dashboard > Instagram > API setup with Instagram login, e.g. 17841...).
# Do NOT use the app-scoped user ID (the `id` field of /me): POST /<IG_ID>/media rejects it with
# error 100 / subcode 33.
# Default (S.A.E Method) credentials:
# S.A.E Method Instagram @sylvana_sae professional account ID (also the connector's built-in fallback).
INSTAGRAM_BUSINESS_ACCOUNT_ID=17841400152764725
INSTAGRAM_GRAPH_USER_ID=17841400152764725
# HOAWS credentials (used automatically when a scheduled post's brand is 'HOAWS')
HOAWS_INSTAGRAM_ACCESS_TOKEN=your_hoaws_instagram_access_token
# HOAWS Instagram @hoaws.digital professional account ID (= user_id of GET /me, NOT the app-scoped id).
HOAWS_INSTAGRAM_BUSINESS_ACCOUNT_ID=17841472384783238
HOAWS_INSTAGRAM_GRAPH_USER_ID=17841472384783238

# TikTok (Content Posting API)
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token

# YouTube (Data API v3). All FOUR are required by src/lib/connectors/youtube.ts: the connector
# validates YOUTUBE_ACCESS_TOKEN against oauth2 v3 tokeninfo and silently refreshes it using
# YOUTUBE_REFRESH_TOKEN + GOOGLE_CLIENT_ID/SECRET. Without the refresh token, the first token
# expiry fails the release permanently rather than recovering.
# Obtain the access + refresh pair in ONE visit: https://lumensocial.vercel.app/api/auth/google
# (one Google grant also feeds GOOGLE_BUSINESS_REFRESH_TOKEN below).
# Also confirm "YouTube Data API v3" is ENABLED on the Google Cloud project, otherwise uploads
# return 403 even with a valid token.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
YOUTUBE_ACCESS_TOKEN=your_youtube_access_token
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token

# Google Business Profile (My Business API)
GOOGLE_BUSINESS_ACCESS_TOKEN=your_google_business_access_token
GOOGLE_BUSINESS_LOCATION=accounts/YOUR_ACCOUNT_ID/locations/YOUR_LOCATION_ID

# Snapchat (Marketing API)
SNAPCHAT_ACCESS_TOKEN=your_snapchat_access_token
SNAPCHAT_AD_ACCOUNT_ID=your_snapchat_ad_account_id

# MyMarky content sources (one API key + business ID per brand)
MYMARKY_API_KEY_SAE=your_mymarky_api_key_sae
MYMARKY_BUSINESS_ID_SAE=cd72203a-32bf-4832-9b72-6bb767b2da90
MYMARKY_API_KEY_TESSERA=your_mymarky_api_key_tessera
MYMARKY_BUSINESS_ID_TESSERA=e2258821-9e9a-43b0-bff3-0e7419d6368a
# HOAWS brand content source. Without BOTH values, /api/pull-mymarky reports HOAWS as "not configured"
# and skips it - it never calls MyMarky with an empty business ID.
# NOTE: the API needs the business UUID, NOT the workspace slug from the URL
# (https://app.mymarky.ai/ws/hoaws/home -> slug "hoaws" is rejected; verified 2026-09-27).
MYMARKY_API_KEY_HOAWS=your_mymarky_api_key_hoaws
MYMARKY_BUSINESS_ID_HOAWS=d36bd055-5dca-49e7-b1d4-2f218e6c051f

# Pollination.ai (Image + Video Generation)
POLLINATION_API_KEY=your_pollination_api_key

# Cron secret (to secure the cron endpoint). The post-scheduler endpoint ALSO accepts a
# Bearer ADMIN_PASSWORD token - that is how the in-app 60s background ticker authenticates
# (Vercel Hobby plans only run the daily cron once per day, so the ticker releases due posts
# while a user is logged in; atomic row claims make the concurrent runs safe).
CRON_SECRET=your_cron_secret
# Token expiry reminder emails (api/cron/token-reminder.ts -> Resend).
# Recipients/dates live in Supabase app_settings (keys starting with token_reminder_).
RESEND_API_KEY=re_your_resend_api_key
REMINDER_EMAIL_FROM=LumenSocial <reminders@your-verified-domain>
